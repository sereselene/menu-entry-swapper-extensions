{
  "runtime.version": "Lua 5.3",
  "runtime.path": [
    "?.lua"
  ],
  "diagnostics.globals": [
    "ui",
    "id",
    "Event",
    "Plugin",
    "PersistentDB",
    "config",
    "PluginShutdown",
    "prettyui",
    "describe",
    "insulate",
    "it",
    "before_each",
    "after_each",
    "setup",
    "teardown",
    "spy",
    "stub",
    "mock"
  ],
  "workspace.ignoreDir": [
    "lua_modules"
  ]
}
